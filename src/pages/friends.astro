---
import Icon from '../components/Icon.astro';
import Identicon from '../components/Identicon.astro';
import PageBanner from '../components/PageBanner.astro';
import { site } from '../config';
import { friendGroups } from '../data/friends';
import BaseLayout from '../layouts/BaseLayout.astro';

const mine = {
  name: site.title,
  url: Astro.site?.origin,
  avatar: new URL(site.avatar, Astro.site).href,
  desc: site.subtitle,
};
---

<BaseLayout title="友链" description="朋友们的小站">
  <PageBanner image="/img/friends-banner.webp" tag="友链" title="海内存知己，天涯若比邻">
    <p class="page-banner-sub">欢迎来交换友链～</p>
    <a class="page-banner-link" href="#apply"><Icon name="heart" /> 申请友链</a>
  </PageBanner>

  {
    friendGroups.map((group) => (
      <section class="card">
        <div class="box-header">
          <Icon name="users" /> {group.title} <span class="counter">{group.items.length}</span>
        </div>
        {group.desc && <p class="fr-desc">{group.desc}</p>}
        {group.items.length > 0 && (
          <div class="fr-grid">
            {group.items.map((f) => (
              <a class="fr-card" href={f.url} target="_blank" rel="noopener">
                <span class="fr-avatar">
                  <Identicon seed={f.name} />
                  {f.avatar && <img src={f.avatar} alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()" />}
                </span>
                <div class="fr-info">
                  <div class="fr-name">{f.name}</div>
                  <div class="fr-text">{f.desc}</div>
                </div>
              </a>
            ))}
          </div>
        )}
      </section>
    ))
  }

  <section class="card" id="apply">
    <div class="box-header"><Icon name="heart" /> 申请友链</div>
    <div class="fr-apply">
      <p>欢迎交换友链！在 GitHub 上找到我，或者通过页脚的邮箱联系，附上下面这样的信息就好：</p>
      <pre>{`name: ${mine.name}
url: ${mine.url}
avatar: ${mine.avatar}
desc: ${mine.desc}`}</pre>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .fr-desc {
    padding: 12px 18px 0;
    font-size: 14px;
    color: var(--c-text-2);
  }

  /* 分组里还没有站点时，说明文字就是最后一行，底下补上留白 */
  .fr-desc:last-child {
    padding-bottom: 16px;
  }

  .fr-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
    padding: 16px 18px 18px;
  }

  .fr-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border: 1px solid var(--c-border-soft);
    border-radius: 10px;
    background: var(--c-panel);
    transition: border-color 0.2s, transform 0.2s;
  }

  .fr-card:hover {
    border-color: var(--c-accent);
    transform: translateY(-2px);
  }

  /* 头像加载失败时露出下面的格子图 */
  .fr-avatar {
    position: relative;
    flex: none;
    width: 48px;
    height: 48px;
    overflow: hidden;
    border-radius: 50%;
    transition: transform 0.5s;
  }

  .fr-avatar > * {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fr-card:hover .fr-avatar {
    transform: rotate(360deg);
  }

  .fr-info {
    min-width: 0;
  }

  .fr-name {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .fr-text {
    margin-top: 2px;
    font-size: 12.5px;
    color: var(--c-text-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .fr-apply {
    padding: 14px 18px 18px;
    font-size: 14px;
    color: var(--c-text-2);
  }

  .fr-apply pre {
    margin: 10px 0 0;
    padding: 12px 14px;
    overflow-x: auto;
    border: 1px solid var(--c-border-soft);
    border-radius: 8px;
    background: var(--c-code-bg);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--c-text);
  }
</style>
