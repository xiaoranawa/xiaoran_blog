<div class="cookie" id="cookie" transition:persist hidden role="region" aria-label="Cookie 提示">
  <span class="cookie-emoji" aria-hidden="true">🍪</span>
  <p class="cookie-text">
    本站用 Cookie 和浏览器本地存储记住你的偏好（比如深浅色），也会借助第三方服务统计访问量、显示大致来访地区。继续浏览就表示你同意啦~
  </p>
  <button class="btn cookie-ok" type="button">知道了</button>
</div>

<style is:global>
  .cookie {
    position: fixed;
    left: 16px;
    bottom: 24px;
    /* 比手机菜单的遮罩低一层，打开菜单时不会挡住 */
    z-index: 60;
    width: min(360px, calc(100vw - 32px));
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 12px;
    align-items: start;
    padding: 14px 16px;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--c-panel-solid) 85%, transparent);
    backdrop-filter: var(--blur);
    -webkit-backdrop-filter: var(--blur);
    box-shadow: var(--shadow-2);
    font-size: 13.5px;
    color: var(--c-text-2);
    animation: cookie-in 0.4s ease-out;
  }

  .cookie[hidden] {
    display: none;
  }

  .cookie.leaving {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.3s, transform 0.3s;
  }

  @keyframes cookie-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .cookie-emoji {
    font-size: 22px;
    line-height: 1.2;
  }

  .cookie-text {
    line-height: 1.6;
  }

  .cookie-ok {
    grid-column: 2;
    justify-self: end;
    height: 30px;
  }

  @media (max-width: 959px) {
    .cookie {
      left: 12px;
      bottom: 16px;
      width: calc(100vw - 76px);
    }
  }
</style>

<script>
  // 点过「知道了」就不再出现；元素换页时保留，提示不会每页重新弹一遍
  const box = document.getElementById('cookie');
  let agreed = false;
  try {
    agreed = localStorage.getItem('cookie-ok') === '1';
  } catch {}
  if (box && !agreed) {
    box.hidden = false;
    // 进场动画只播一次，换页时元素被挪动也不会重播
    box.addEventListener('animationend', () => (box.style.animation = 'none'), { once: true });
    box.querySelector('.cookie-ok')?.addEventListener('click', () => {
      try {
        localStorage.setItem('cookie-ok', '1');
      } catch {}
      box.classList.add('leaving');
      setTimeout(() => (box.hidden = true), 300);
    });
  }
</script>
