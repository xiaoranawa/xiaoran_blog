---
import { copyTip } from '../config';
---

<div class="copy-tip" id="copy-tip" transition:persist role="status" aria-live="polite">{copyTip}</div>

<style is:global>
  /* 顶部整条的复制提示，颜色跟着背景图的主色调走 */
  .copy-tip {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 110;
    padding: 13px 16px;
    background: hsl(var(--tint-h) calc(var(--tint-s) * 0.8) 46% / 0.92);
    backdrop-filter: var(--blur);
    -webkit-backdrop-filter: var(--blur);
    box-shadow: var(--shadow-2);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    text-align: center;
    visibility: hidden;
    transform: translateY(-100%);
    transition:
      transform 0.35s ease,
      visibility 0s 0.35s;
  }

  .copy-tip.show {
    visibility: visible;
    transform: none;
    transition: transform 0.35s ease;
  }

  :root[data-theme='dark'] .copy-tip {
    background: hsl(var(--tint-h) calc(var(--tint-s) * 0.6) 30% / 0.92);
  }

  @media (prefers-reduced-motion: reduce) {
    .copy-tip {
      opacity: 0;
      transform: none;
      transition:
        opacity 0.2s,
        visibility 0s 0.2s;
    }

    .copy-tip.show {
      opacity: 1;
      transition: opacity 0.2s;
    }
  }
</style>

<script>
  const tip = document.getElementById('copy-tip')!;
  let timer: ReturnType<typeof setTimeout> | undefined;

  // 连着复制会重新计时
  function show() {
    tip.classList.add('show');
    clearTimeout(timer);
    timer = setTimeout(() => tip.classList.remove('show'), 2500);
  }

  document.addEventListener('copy', (e) => {
    // 搜索框这类输入框里复制、或者什么都没选中时不提示
    if ((e.target as Element | null)?.closest?.('input, textarea, [contenteditable]')) return;
    if (!document.getSelection()?.toString().trim()) return;
    show();
  });

  // 代码块的复制按钮走的是剪贴板接口，不会触发 copy 事件，复制成功后它会派发这个事件
  document.addEventListener('copied', show);
</script>
