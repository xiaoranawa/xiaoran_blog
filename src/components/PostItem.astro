---
import { ymd } from '../utils/date';
import type { Post } from '../utils/posts';
import Icon from './Icon.astro';
import Identicon from './Identicon.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, cover, date } = post.data;
---

<article class="pi">
  <a class="pi-cover" href={post.url} tabindex="-1" aria-hidden="true">
    {cover ? <img src={cover} alt="" loading="lazy" decoding="async" /> : <Identicon seed={post.id} />}
  </a>
  <div class="pi-body">
    <h2 class="pi-title"><a href={post.url}>{title}</a></h2>
    <p class="pi-excerpt">{post.excerpt}</p>
    <div class="pi-meta">
      <span><Icon name="file-text" /> {post.words} 字</span>
      <span><Icon name="clock" /> {post.minutes} 分钟</span>
      <span><Icon name="calendar" /> <time datetime={date.toISOString()}>{ymd(date)}</time></span>
    </div>
  </div>
</article>

<style is:global>
  .pi {
    display: flex;
    gap: 20px;
    padding: 18px;
  }

  .pi + .pi {
    border-top: 1px solid var(--c-border-soft);
  }

  .pi-cover {
    flex: none;
    width: 260px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px;
    background: var(--c-soft);
  }

  .pi-cover img,
  .pi-cover .identicon {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .pi:hover .pi-cover :is(img, .identicon) {
    transform: scale(1.06);
  }

  .pi-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .pi-title {
    font-family: var(--font-title);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.4;
  }

  .pi-title a {
    background: linear-gradient(var(--c-accent), var(--c-accent)) 0 100% / 0 2px no-repeat;
    transition: background-size 0.3s, color 0.3s;
  }

  .pi-title a:hover {
    color: var(--c-accent);
    background-size: 100% 2px;
  }

  .pi-excerpt {
    margin: 8px 0 12px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--c-text-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pi-meta {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-size: 12.5px;
    color: var(--c-text-3);
  }

  .pi-meta span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  @media (max-width: 640px) {
    .pi {
      flex-direction: column;
      gap: 12px;
      padding: 14px;
    }

    .pi-cover {
      width: 100%;
      aspect-ratio: 2 / 1;
    }
  }
</style>
