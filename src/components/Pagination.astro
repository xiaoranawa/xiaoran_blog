---
import Icon from './Icon.astro';

interface Props {
  current: number;
  total: number;
  // 列表首页的地址，文章是 /，闲言是 /memos/
  base?: string;
}

const { current, total, base = '/' } = Astro.props;
const href = (n: number) => (n === 1 ? base : `${base}page/${n}/`);

// 首尾和当前页附近的页码，中间用省略号
const pages: (number | '…')[] = [];
for (let n = 1; n <= total; n++) {
  if (n === 1 || n === total || Math.abs(n - current) <= 1) pages.push(n);
  else if (pages.at(-1) !== '…') pages.push('…');
}
---

{
  total > 1 && (
    <nav class="pager" aria-label="分页">
      {current > 1 && (
        <a class="pager-btn pager-step pager-prev" href={href(current - 1)} aria-label="上一页">
          <Icon name="chevron-left" />
          <span class="pager-tip">上页</span>
        </a>
      )}
      {pages.map((p) =>
        p === '…' ? (
          <span class="pager-gap">…</span>
        ) : (
          <a class:list={['pager-btn', { current: p === current }]} href={href(p)} aria-current={p === current ? 'page' : undefined}>
            {p}
          </a>
        ),
      )}
      <form class="pager-jump" data-total={total} data-base={base}>
        <input type="text" inputmode="numeric" maxlength="3" placeholder="页码" aria-label="跳到第几页" />
        <button class="pager-btn" type="submit" aria-label="跳转" title="跳转">
          <Icon name="chevrons-right" />
        </button>
      </form>
      {current < total && (
        <a class="pager-btn pager-step pager-next" href={href(current + 1)} aria-label="下一页">
          <span class="pager-tip">下页</span>
          <Icon name="chevron-right" />
        </a>
      )}
    </nav>
  )
}

<style is:global>
  .pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 14px 18px 18px;
    border-top: 1px solid var(--c-border-soft);
  }

  .pager-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 10px;
    border: 1px solid var(--c-border);
    border-radius: 8px;
    background: var(--c-panel);
    color: var(--c-text);
    font-size: 14px;
    font-weight: 600;
    box-shadow: var(--shadow-1);
    transition:
      color 0.25s,
      border-color 0.25s,
      background-color 0.25s,
      transform 0.25s;
  }

  .pager-btn:hover {
    color: var(--c-accent);
    border-color: var(--c-accent);
    transform: translateY(-1px);
  }

  .pager-btn.current {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-panel-solid);
    cursor: default;
    transform: none;
  }

  .pager-gap {
    padding: 0 2px;
    color: var(--c-text-3);
  }

  .pager-next {
    margin-left: auto;
  }

  /* 「上页」「下页」平时藏着，鼠标移上去从箭头旁边滑出来，和倒计时那种切换一个味道 */
  .pager-tip {
    display: inline-block;
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition:
      max-width 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      margin 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease;
  }

  .pager-next .pager-tip {
    transform: translateX(8px);
  }

  .pager-prev .pager-tip {
    transform: translateX(-8px);
  }

  .pager-step:hover .pager-tip,
  .pager-step:focus-visible .pager-tip {
    max-width: 3em;
    opacity: 1;
    transform: none;
  }

  .pager-next:hover .pager-tip,
  .pager-next:focus-visible .pager-tip {
    margin-right: 4px;
  }

  .pager-prev:hover .pager-tip,
  .pager-prev:focus-visible .pager-tip {
    margin-left: 4px;
  }

  /* 跳页：平时只露出 »，鼠标移上去或者点进输入框时，左边展开一个小输入框 */
  .pager-jump {
    display: inline-flex;
    align-items: center;
  }

  .pager-jump input {
    width: 0;
    height: 36px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 8px;
    background: var(--c-panel);
    font-size: 14px;
    text-align: center;
    outline: none;
    opacity: 0;
    transition:
      width 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      padding 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      margin 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease,
      border-color 0.25s;
  }

  .pager-jump:hover input,
  .pager-jump:focus-within input {
    width: 64px;
    padding: 0 8px;
    margin-right: 6px;
    opacity: 1;
    border-color: var(--c-border);
  }

  .pager-jump input:focus {
    border-color: var(--c-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .pager-tip,
    .pager-jump input {
      transition: opacity 0.2s ease;
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  document.addEventListener('input', (e) => {
    const input = (e.target as Element).closest<HTMLInputElement>('.pager-jump input');
    if (input) input.value = input.value.replace(/\D/g, '');
  });

  document.addEventListener('submit', (e) => {
    const form = (e.target as Element).closest<HTMLFormElement>('.pager-jump');
    if (!form) return;
    e.preventDefault();
    const input = form.querySelector('input')!;
    const page = Math.min(Number(input.value), Number(form.dataset.total));
    // 没填页码就先把输入框点开（手机上没有悬停）
    if (!page) return input.focus();
    const base = form.dataset.base ?? '/';
    navigate(page === 1 ? base : `${base}page/${page}/`);
  });
</script>
